#!/libexec/zsh -f
# example service: TCP server giving wasm zsh per connection.
#
# Listens on port 12323; each TCP connection forks a fresh wasm zsh
# under yos and pipes the socket to its stdio. Connect from anywhere
# reachable:
#
#     telnet -E HOST 12323
#     nc HOST 12323
#
# This IS the real goal — runit keeps the listener alive across crashes
# and yos-tcpserver gives multi-session. Known limitation: second
# concurrent session crashes the listener (yos fork-after-fork race);
# runsv will restart it on crash, so single-session-at-a-time works
# robustly.
#
# yos.sh exports PATH=$ALL/libexec so the bare names resolve via
# yos_execvp's PATH walk.
exec 2>&1
exec yos-tcpserver 12323 zsh
