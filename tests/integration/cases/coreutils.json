[
  {
    "id": "echo-args",
    "argv": ["echo", "hello", "world"],
    "expect": { "exitCode": 0, "rawStdout": "hello world\n", "gridRow": { "row": 0, "equals": "hello world" } }
  },
  {
    "id": "cat-stdin",
    "argv": ["cat"],
    "stdin": "line one\nline two\n",
    "expect": { "exitCode": 0, "rawStdout": "line one\nline two\n", "gridContains": ["line one", "line two"] }
  },
  {
    "id": "wc-counts",
    "argv": ["wc"],
    "stdin": "one\ntwo three\nfour\nfive six\nseven\n",
    "expect": { "exitCode": 0, "gridContains": ["5", "7", "34"] }
  },
  {
    "id": "grep-fixed-match",
    "argv": ["grep", "apple"],
    "stdin": "apple\nbanana\napple\n",
    "expect": { "exitCode": 0, "rawStdout": "apple\napple\n", "gridContains": ["apple"] }
  },
  {
    "id": "sed-substitute-global",
    "argv": ["sed", "s/foo/BAR/g"],
    "stdin": "foo bar foo\n",
    "expect": { "exitCode": 0, "rawStdout": "BAR bar BAR\n", "gridContains": ["BAR bar BAR"] }
  },
  {
    "id": "sort-lexicographic",
    "argv": ["sort"],
    "stdin": "banana\napple\ncherry\n",
    "expect": { "exitCode": 0, "rawStdout": "apple\nbanana\ncherry\n" },
    "knownBrowserGap": "The browser engine models std streams as the integer sentinel FILE 1/2/3, but the guest <stdio.h> feof() is a MACRO that dereferences the FILE pointer (fr->file->_flags & __SEOF). feof(1) reads garbage at guest address 13, so at EOF sort takes the !feof branch and err(2)s (file.c:684). Native passes. Fix needs the sysroot to model std streams as real FILE structs (or expose feof as a pure function) — a deeper engine/sysroot change, tracked separately."
  },
  {
    "id": "tr-to-upper",
    "argv": ["tr", "a-z", "A-Z"],
    "stdin": "hello\n",
    "expect": { "exitCode": 0, "rawStdout": "HELLO\n", "gridRow": { "row": 0, "equals": "HELLO" } }
  },
  {
    "id": "cut-field",
    "argv": ["cut", "-d:", "-f2"],
    "stdin": "a:b:c\nd:e:f\n",
    "expect": { "exitCode": 0, "rawStdout": "b\ne\n" }
  }
]
