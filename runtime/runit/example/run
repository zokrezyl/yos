#!/libexec/zsh -f
# example service: TCP server giving each connection a wasm zsh.
#
# Each `telnet -E HOST 12323` (or `nc HOST 12323`) connection forks a
# fresh wasm zsh under yos and pipes the socket to its stdio.
#
# Why we set PATH explicitly here even though tools/yos.sh already
# exported it: PATH propagation across the runit → runsvdir → runsv →
# script → tcpserver → zsh chain is fragile — at least one hop drops
# it on yos today (probably the wasm-libc execvp call), so the
# connected zsh ends up with a stripped/empty PATH and every typed
# command comes back as 'command not found'. yos.sh exports
# YOS_LIBEXEC as the umbrella's libexec absolute store path; we
# re-export it as PATH right here so the spawned zsh is guaranteed
# to find ls / ps / cat / yos-tcpserver / etc.
export PATH=$YOS_LIBEXEC
exec 2>&1
exec yos-tcpserver 12323 zsh
