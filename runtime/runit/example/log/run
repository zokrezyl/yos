#!/bin/sh
# Per-service logger script.
#
# runsv pipes the service's stdout into this script's stdin. We
# exec svlogd against $LOG_DIR/example/ — svlogd handles rotation,
# size caps and atomic appends so the on-disk file is always
# consistent. LOG_DIR is set by ../../../tools/yos.sh --server
# (default: <repo>/runtime/logs) and propagated through runsvdir's
# environment.
#
# Output lands at:
#   $LOG_DIR/example/current        (active log, append-only)
#   $LOG_DIR/example/@<tai64n>.s    (rotated previous logs)
#
# -tt prefixes each line with a tai64n timestamp.
mkdir -p "$LOG_DIR/example"
exec svlogd -tt "$LOG_DIR/example"
